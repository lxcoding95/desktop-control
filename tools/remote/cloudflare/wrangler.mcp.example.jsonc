{
  // TEMPLATE ONLY. No public route, no device relay binding, remote disabled.
  // Enabling remote requires reviewed Durable Object, OAuth and account pairing.
  "name": "desktop-control-mcp-disabled",
  "main": "mcp-worker.ts",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [],
  "services": [
    {
      "binding": "AUTH_SERVER",
      "service": "desktop-control-auth-disabled",
      "entrypoint": "DesktopControlAuthServer"
    }
  ],
  "durable_objects": {"bindings": [{"name": "REMOTE_RELAY", "class_name": "RemoteHealthRelay"}]},
  "migrations": [{"tag": "relay-v1", "new_sqlite_classes": ["RemoteHealthRelay"]}],
  "vars": {
    "PREVIEW_SINGLE_USER": "1",
    "PREVIEW_OWNER_ID": "REPLACE_WITH_EXISTING_OWNER",
    "PREVIEW_DEVICE_ID": "REPLACE_WITH_EXISTING_DEVICE",
    "APPROVE_INITIAL_DEVICE_PAIRING": "0",
    "AUTH_ISSUER": "https://REPLACE_WITH_AUTH_HOST.workers.dev",
    "RESOURCE_URL": "https://REPLACE_WITH_MCP_HOST.workers.dev/mcp",
    "ENABLE_REMOTE_HEALTH": "0"
  }
}
