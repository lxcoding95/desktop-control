{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "desktop-control-private",
  "version": "0.0.1-preview.4",
  "author": {
    "name": "Anon Allman",
    "email": "334623916+lxcoding95@users.noreply.github.com"
  },
  "description": "Private local MCP preview: host-granted diagnostics, isolated workspace/PDF/terminal, separate browser and visible Windows desktop control. No autonomous updater.",
  "repository": "https://github.com/lxcoding95/desktop-control",
  "license": "MIT",
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "Desktop Control Private",
        "developerName": "Anon Allman",
        "shortDescription": "Private desktop & workspace",
        "capabilities": [
          "Read",
          "Write",
          "Interactive"
        ],
        "defaultPrompt": null
      }
    }
  }
}
