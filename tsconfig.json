{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "sourceMap": false,
    "types": ["node"],
    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["packages/**/*.mts"]
}
