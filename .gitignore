# Generated output and temporary files
dist/
build/
target/
coverage/
.cache/
.tmp/
temp/
*.tmp
*.log
*.pid
*.tsbuildinfo

# Node / package managers (keep lockfiles tracked)
node_modules/
.pnpm-store/
.npm/
.yarn/cache/
.yarn/unplugged/

# Python (if ever used for tooling)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# IDE / OS
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo

# Local-only credentials and config (do NOT ignore public examples)
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.p12
*.pfx
*.key
secrets/
.credentials/

# Desktop Control preview activation (generated only on the owner's PC)
# Keep even mistakenly generated copies out of commits.
desktop-control.txt
.dc-wss-local-*.json
.dc-preview-credentials-*.json
.preview-owner-local.json

# Cloudflare local secret bindings, private issuer state and staged vault files
.dev.vars
.dev.vars.*
*.preview-license
.dc-vault-write-*.tmp
.dc-license-update-*.tmp
