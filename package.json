{
  "name": "desktop-control",
  "private": true,
  "version": "0.0.0",
  "author": "Anon Allman",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node packages/mcp-server/scripts/build-native.mjs && node --experimental-strip-types --test packages/mcp-server/test/*.test.mts",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "build": "tsc --project tsconfig.json && node packages/mcp-server/scripts/build-native.mjs && node tools/plugin/build-private.mjs",
    "start:mcp": "node dist/packages/mcp-server/src/index.mjs",
    "typecheck:bridge": "tsc --noEmit --project tsconfig.bridge.json",
    "test:protocol": "node --test packages/mcp-server/test/*.test.mjs",
    "lint": "eslint --max-warnings 0 packages eslint.config.mjs",
    "test:private-files": "node --test packages/private-files/test/*.test.mjs",
    "test:private-components": "node --test --test-concurrency=1 packages/private-browser/test/*.test.mjs packages/private-desktop/test/*.test.mjs packages/private-settings/test/*.test.mjs tools/plugin/release-policy.test.mjs",
    "test:update-policy": "node --test packages/update-policy/index.test.mjs packages/update-policy/activation-machine.test.mjs",
    "test:bridge-updater": "node packages/bridge-updater/build-native.mjs && node --test packages/bridge-updater/runtime.test.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:private-files && npm run build && npm run test:private-components && npm run test:update-policy && npm run test:bridge-updater && npm run test:remote && npm run test:remote:integration && npm run test:remote:ticket && npm run test:remote:durable && npm run test:remote:oauth-gate && npm run test:protocol",
    "test:remote": "node --test tools/remote/health-server.test.mjs",
    "inspect:remote": "npx --no-install @modelcontextprotocol/inspector --cli node tools/remote/health-server.mjs --method tools/list --strict --format json",
    "inspect:remote:health": "npx --no-install @modelcontextprotocol/inspector --cli node tools/remote/health-server.mjs --method tools/call --tool-name desktop_control.remote_health --format json",
    "test:remote:relay": "node --test tools/remote/relay-core.test.mjs",
    "test:remote:device": "node --test tools/remote/device-health-channel.test.mjs",
    "test:remote:integration": "node --test tools/remote/relay-core.test.mjs tools/remote/device-health-channel.test.mjs",
    "test:remote:ticket": "node --test tools/remote/device-ticket.test.mjs",
    "test:remote:oauth-gate": "node --test tools/remote/oauth-health-gate.test.mjs",
    "test:remote:durable": "node --test tools/remote/durable-ticket-store.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/inspector": "2.12.0",
    "@types/node": "22.15.30",
    "eslint": "10.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
